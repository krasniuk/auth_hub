[
    {auth_hub, [
        {listen_port, 1913},
        %% --- create hash ---
        {salt, " hack_me)"}
        % === =========== ===
    ]},

    {poolboy, [
        {pools, [
            {pg_pool, [
                {name, {local, pg_pool}},
                {strategy, fifo},
                {worker_module, auth_hub_pg},
                {size, 10},
                {max_overflow, 5}
            ], [
                {host, "89.21.76.223"}, {port, 5432}, {ssl, true}, {ssl_opts, [{verify, verify_none}]},
                {username, "auth_hub_test"}, {password, "P@ssw0rd!324"}, {database, "test_database"}]}
        ]}
    ]},

    {kernel, [
        % debug info notice warning error critical alert emergency
        {logger_level, debug},
        {logger, [

            %% Write in console
            {handler, default, logger_std_h,
                #{
                    level => debug,
                    config => #{type => standard_io},
                    formatter => {logger_formatter, #{single_line => true, template => [time, " [",level,"] ", msg,"\n"]}}
                }
            },

            %% lagger_handler in auth_hub_log
            {handler, lagger_handler, auth_hub_log,
                #{level => debug,
                    formatter => {logger_formatter, #{single_line => true, template => [time, " [",level,"] ", msg,"\n"]}}
                }
            },

            %% Write in file
            {handler, debug_file, logger_disk_log_h,
                #{level => debug,
                    config => #{
                        file => "log/debug.log",
                        type => wrap,
                        max_no_bytes => 1073741824,
                        max_no_files => 2},
                    formatter => {logger_formatter, #{single_line => true, template => [time, " [",level,"] ", msg,"\n"]}}
                }
            },
            {handler, info_file, logger_disk_log_h,
                #{level => info,
                    config => #{
                        file => "log/info.log",
                        type => wrap,
                        max_no_bytes => 1073741824,
                        max_no_files => 7},
                    formatter => {logger_formatter, #{single_line => true, template => [time, " [",level,"] ", msg,"\n"]}}
                }
            },
            {handler, error_file, logger_disk_log_h,
                #{level => error,
                    config => #{
                        file => "log/error.log",
                        type => wrap,
                        max_no_bytes => 1073741824,
                        max_no_files => 20},
                    formatter => {logger_formatter, #{single_line => true, template => [time, " [",level,"] ", mfa, " ", msg,"\n"]}}
                }
            }
        ]}
    ]},

    {sasl, [
        {sasl_error_logger, false}
    ]}

].